{
  "name": "policy_preprocessor",
  "steps": [
    {
      "registry_name": "rename_observations_processor",
      "config": {
        "rename_map": {}
      }
    },
    {
      "registry_name": "to_batch_processor",
      "config": {}
    },
    {
      "registry_name": "smolvla_new_line_processor",
      "config": {}
    },
    {
      "registry_name": "tokenizer_processor",
      "config": {
        "max_length": 48,
        "task_key": "task",
        "padding_side": "right",
        "padding": "longest",
        "truncation": true,
        "tokenizer_name": "/opt/data/private/liusong/hf_models/SmolVLM2-500M-Video-Instruct"
      }
    },
    {
      "registry_name": "device_processor",
      "config": {
        "device": "cuda",
        "float_dtype": null
      }
    },
    {
      "registry_name": "umi",
      "config": {}
    },
    {
      "registry_name": "normalizer_processor",
      "config": {
        "eps": 1e-08,
        "features": {
          "observation.state": {
            "type": "STATE",
            "shape": [
              10
            ]
          },
          "observation.images.agentview": {
            "type": "VISUAL",
            "shape": [
              3,
              256,
              256
            ]
          },
          "action": {
            "type": "ACTION",
            "shape": [
              10
            ]
          }
        },
        "norm_map": {
          "VISUAL": "IDENTITY",
          "STATE": "IDENTITY",
          "ACTION": "IDENTITY"
        }
      },
      "state_file": "policy_preprocessor_step_6_normalizer_processor.safetensors"
    }
  ]
}